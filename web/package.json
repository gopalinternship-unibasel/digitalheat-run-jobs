{
  "name": "digitalheat-run-jobs",
  "private": true,
  "version": "1.0.0",
  "description": "The Run jobs page of the DigitalHeat dashboard: five kinds of computing work answered live by a local service.",
  "type": "module",
  "scripts": {
    "api": "cd .. && python -m dh.serve",
    "dev": "vite --port 5420 --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5421 --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
